# Fixture for the SSH-credential end-to-end test.
#
# The payload is fetched over git+ssh twice: through `source=`, which makepkg
# fetches on the worker before the chroot is entered, and by `prepare()`,
# inside the chroot, as a package that clones for itself does. Each succeeds
# only if the worker's credential reached where it ran -- the part of the
# credential path that unit tests cannot cover, because it depends on
# makechrootpkg's uid mapping and on what the chroot has bound in.
pkgname=aurcache-ssh-test
pkgver=1.0.0
pkgrel=1
pkgdesc="Fetches its source over git+ssh to prove build credentials reach the chroot"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/Lukas-Heiligenbrunner/AURCache"
license=('GPL-3.0-or-later')
makedepends=('git' 'openssh')
source=('payload::git+ssh://git@gitssh/srv/git/payload.git')
sha256sums=('SKIP')

prepare() {
  git clone -q ssh://git@gitssh/srv/git/payload.git "$srcdir/cloned"
}

package() {
  install -Dm644 "$srcdir/payload/marker.txt" \
    "${pkgdir}/usr/share/aurcache-ssh-test/marker.txt"
  install -Dm644 "$srcdir/cloned/marker.txt" \
    "${pkgdir}/usr/share/aurcache-ssh-test/cloned-marker.txt"
}
