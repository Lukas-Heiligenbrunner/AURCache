# Regression fixture for the build agent. NOT a real package.
#
# `scripts/test-build-agent.sh` builds this with `aurcache-build-agent build`
# in a container under the flags a worker gives one. It runs as the build user
# twice: sourced by `makepkg --printsrcinfo`, which the agent reads its
# dependencies from before root installs them, and in `build()`. Both times it
# tries what a hostile package would: becoming root, finding something of
# root's to talk to, writing the report; `build()` also looks for the worker's
# SSH key. It prints one `probe name=value` line per attempt, and the script
# asserts each of them.
#
# Both polarities: the same build shows what must work. `tree` is not in the
# builder image, so it is only there if root installed it before the build;
# the git source is only cloned if makepkg ran with a working environment.
#
# With AURCACHE_TEST_FORGE set, what `--printsrcinfo` prints also names a
# package file it made, whose install scriptlet would leave a mark in the work
# directory, and words that are pacman's options: they reach root's pacman as
# targets, which it cannot find, and the build fails before it starts.
#
# With AURCACHE_TEST_REPO set (by the job's makepkg.conf), it depends on
# `aurcache-agent-thief`, from the test's own repository, whose install
# scriptlet runs as root, and reports whether the image's upgrade saw that
# repository.
#
# With AURCACHE_TEST_GITSSH set to the address of the test's git server, it
# also fetches a source over git+ssh and reaches the server again from
# build(), which works only through the worker's SSH link; it asks the agent
# for a signature that is not a login, which ssh-agent makes; and it reports
# what the thief's scriptlet, which does the same hunt as root, found. The
# script execs `sleep 3601` into the container from outside; build() reports
# whether it still runs: the agent spares the link alone.
#
# It expects what the script sets up: the work directory at /work, and a
# repository at /srv/aurcache-agent-test/upstream.git.
pkgname=aurcache-agent-hostile
pkgver=1.0.0
pkgrel=1
pkgdesc="Hostile fixture for the build agent's container test"
arch=('any')
url="https://github.com/Lukas-Heiligenbrunner/AURCache"
license=('GPL-3.0-or-later')
makedepends=('tree' 'git')
source=("fixture::git+file:///srv/aurcache-agent-test/upstream.git")
sha256sums=('SKIP')
if [[ -n ${AURCACHE_TEST_REPO:-} ]]; then
  makedepends+=('aurcache-agent-thief')
fi
if [[ -n ${AURCACHE_TEST_GITSSH:-} ]]; then
  source+=("payload::git+ssh://git@${AURCACHE_TEST_GITSSH}/srv/git/payload.git")
  sha256sums+=('SKIP')
  # Run as makepkg reads this file for the build: the agent is there from
  # its start, and not yet while the dependencies are read.
  if [[ -n ${SSH_AUTH_SOCK:-} ]] && ssh-add -L 2>/dev/null | grep -q '^ssh-ed25519 '; then
    printf 'probe toplevel-agent-key=listed\n'
  fi
fi

_work=/work
_scratch=/var/lib/aurcache-build
_thief=/var/tmp/aurcache-thief

_probe() {
  printf 'probe %s=%s\n' "$1" "$2"
}

# One line of /proc/self/status.
_status() {
  awk -v field="$1:" '$1 == field { print $2 }' /proc/self/status
}

# Try a command that must fail: `blocked` when it did, `worked` when it did not.
# makepkg aborts the build on any command that fails outside a condition, so
# every attempt is made inside one.
_attempt() {
  local name=$1
  shift
  if "$@" >/dev/null 2>&1; then
    _probe "$name" worked
  else
    _probe "$name" blocked
  fi
}

_write() {
  : >"$1"
}

_append() {
  : >>"$1"
}

# A package whose install script, were root ever to install it, leaves a mark.
_make_evil_package() { # where
  mkdir -p "$1/evil"
  (
    cd "$1/evil"
    printf '%s\n' 'pkgname = aurcache-agent-evil' 'pkgver = 1-1' 'pkgdesc = evil' \
      'builddate = 0' 'size = 0' 'arch = any' >.PKGINFO
    printf '%s\n' 'post_install() {' "  touch $_work/evil-ran" '}' >.INSTALL
    bsdtar -cf - .PKGINFO .INSTALL | zstd -q >"$1/aurcache-agent-evil-1-1-any.pkg.tar.zst"
  )
}

# Root's processes but the agent, and but what the engine started in the
# container from outside (the worker's SSH link, whose parent is not in this
# PID namespace), by pid; `none` when there is none.
_root_processes() {
  ps -e -o uid=,pid=,ppid= | awk '$1 == 0 && $2 != 1 && $3 != 0 { print $2 }' |
    paste -sd, | grep . || echo none
}

# Listening unix sockets this user could connect to and does not own, which
# root could be behind: an abstract one, or one it may write to. Not the SSH
# agent socket a build given the worker's key has, which the agent answers
# only by passing on to the worker's ssh-agent.
_foreign_listeners() {
  local path count=0
  while read -r path; do
    [[ -n ${SSH_AUTH_SOCK:-} && $path == "$SSH_AUTH_SOCK" ]] && continue
    if [[ $path == @* ]] || { [[ -w $path ]] && [[ ! -O $path ]]; }; then
      count=$((count + 1))
    fi
  done < <(awk 'NR > 1 && $4 == "00010000" { print $8 }' /proc/net/unix)
  echo "$count"
}

# What this process is, and that it has no way back to root. Every name is
# prefixed with $1.
_identity_and_root() {
  local at=$1
  _probe "${at}uid" "$(id -u)"
  _probe "${at}gid" "$(id -g)"
  _probe "${at}groups" "$(id -G)"
  _probe "${at}capeff" "$(_status CapEff)"
  _probe "${at}capprm" "$(_status CapPrm)"
  _probe "${at}capinh" "$(_status CapInh)"
  _probe "${at}capamb" "$(_status CapAmb)"
  _probe "${at}nonewprivs" "$(_status NoNewPrivs)"
  _attempt "${at}sudo" sudo -n true
  _attempt "${at}su" su -c true root
  _attempt "${at}kill-init" kill -KILL 1
  _attempt "${at}term-init" kill -TERM 1
  _attempt "${at}read-init-environment" cat /proc/1/environ
  _attempt "${at}write-passwd" _append /etc/passwd
  _attempt "${at}write-pacman-conf" _append /etc/pacman.conf
  # Nothing of root's to ask for anything: no process but the agent, and no
  # socket that is not this user's own.
  _probe "${at}root-processes" "$(_root_processes)"
  _probe "${at}foreign-listeners" "$(_foreign_listeners)"
}

# Sourced by `makepkg --printsrcinfo`, before root installs what it prints:
# its probes go to stderr, which the agent puts in the build's output, since
# stdout is the `.SRCINFO`.
if (( ${PRINTSRCINFO:-0} )); then
  _identity_and_root srcinfo- >&2
  # Something left running, which must not see root's install: the agent
  # ends it first. build() looks for it.
  setsid sleep 3600 </dev/null >/dev/null 2>&1 &
  echo "$!" >"$HOME/srcinfo-lingerer"
  if [[ -n ${AURCACHE_TEST_FORGE:-} ]]; then
    _make_evil_package "$HOME"
    printf 'pkgbase = aurcache-agent-hostile\n'
    printf '\tmakedepends = %s\n' "$HOME/aurcache-agent-evil-1-1-any.pkg.tar.zst" \
      "file://$HOME/aurcache-agent-evil-1-1-any.pkg.tar.zst" '-U' '--overwrite=*' \
      "--hookdir=$HOME"
  fi
fi

build() {
  _identity_and_root ""
  local lingerer
  lingerer=$(cat "$HOME/srcinfo-lingerer" 2>/dev/null) || lingerer=
  if [[ -n $lingerer ]] && kill -0 "$lingerer" 2>/dev/null; then
    _probe srcinfo-lingerer alive
  else
    _probe srcinfo-lingerer "${lingerer:+gone}"
  fi
  # Another exec from outside, which has no parent here either: the agent
  # spares the link's process, and kills this one.
  if ps -e -o args= | grep -qx 'sleep 3601'; then
    _probe outside-exec alive
  else
    _probe outside-exec gone
  fi

  # The worker's key: in no file here, not in the job, not in what the build
  # was started with. Its agent is there, and signs what it is asked to.
  # The armour line, put together here so that this file does not hold it.
  local armour="-----BEGIN OPENSSH ""PRIVATE KEY-----"
  _probe key-files "$(grep -rlsIF -e "$armour" /etc /root /var /tmp /work /aurcache /home \
    /srv /run /opt /mnt 2>/dev/null | grep -vc "^$_thief/")"
  _probe key-given "$(grep -alsF -e "$armour" "$_work/in/spec.json" /proc/self/environ \
    /proc/$$/environ 2>/dev/null | wc -l)"
  if ssh-add -L 2>/dev/null | grep -q '^ssh-ed25519 '; then
    _probe agent-key listed
  else
    _probe agent-key missing
  fi
  if [[ -n ${AURCACHE_TEST_REPO:-} ]]; then
    # The upgrade of the image saw the job's repositories and not the one
    # this build's dependency came from.
    _probe build-conf-repository "$(grep -c '^\[thief\]' /etc/pacman.conf)"
    _probe upgrade-conf-repository "$(grep -c '^\[thief\]' /etc/aurcache/pacman-upgrade.conf)"
    if [[ -e /var/tmp/aurcache-upgrade-bait ]]; then
      _probe upgrade-bait taken
    else
      _probe upgrade-bait left
    fi
    _probe thief-ran "$(cat "$_thief/ran" 2>/dev/null || echo no)"
    _probe thief-mem "$(cat "$_thief/mem" 2>/dev/null || echo unknown)"
  fi
  if [[ -n ${AURCACHE_TEST_GITSSH:-} ]]; then
    if [[ -f $srcdir/payload/marker.txt ]]; then
      _probe payload fetched
    else
      _probe payload missing
    fi
    # A PKGBUILD that fetches from its functions, which no source list shows.
    if git ls-remote "ssh://git@${AURCACHE_TEST_GITSSH}/srv/git/payload.git" >/dev/null 2>&1; then
      _probe ssh-in-build reached
    else
      _probe ssh-in-build failed
    fi
    # A signature that is no login: ssh-agent makes it like any other.
    ssh-add -L >"$srcdir/agent.pub" 2>/dev/null
    if echo payload | ssh-keygen -Y sign -f "$srcdir/agent.pub" -n file >/dev/null 2>&1; then
      _probe sshsig signed
    else
      _probe sshsig refused
    fi
    # What the thief's root scriptlet found.
    _probe thief-keys "$(if [[ -f $_thief/keys ]]; then wc -l <"$_thief/keys"; else echo none; fi)"
    _probe thief-procs "$(if [[ -f $_thief/procs ]]; then wc -l <"$_thief/procs"; else echo none; fi)"
    _probe thief-relays "$(wc -l <"$_thief/relays" 2>/dev/null)"
    _probe thief-agents "$(sort "$_thief/agents" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
    _probe thief-sshsig "$(sort -u "$_thief/sshsig" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
  fi

  # The work directory is root's: nothing beside `out/`, nothing in it, and
  # no renaming it away. `pkg/` is where packages go, and is the build's.
  _attempt write-report _write "$_work/out/report.json"
  _attempt rename-out mv "$_work/out" "$_work/out.moved"
  _attempt write-work _write "$_work/planted"
  _attempt write-makepkg-conf _append "$(dirname "$BUILDDIR")/makepkg.conf"
  _attempt write-pkg _write "$_work/pkg/.probe"
  rm -f "$_work/pkg/.probe"

  # What must have worked for the build to get here.
  if tree --version >/dev/null 2>&1; then
    _probe dependency installed
  else
    _probe dependency missing
  fi
  if [[ -f $srcdir/fixture/README ]]; then
    _probe source cloned
  else
    _probe source missing
  fi

  # Processes orphaned in here become the agent's children, since it is the
  # container's first process, and it collects them when they end.
  for _ in 1 2 3 4 5; do
    (sleep 0.2 &)
  done
  sleep 2
  _probe zombies "$(ps -e -o stat= | grep -c '^Z')"

  # A link in pkg/, named like a package: the agent hands back files only,
  # and follows no link.
  ln -s /etc/passwd "$_work/pkg/aurcache-agent-link-1-1-any.pkg.tar.zst"

  # Something the build leaves running, holding its output open: the agent
  # ends it before it reports.
  (setsid sleep 3600 &)

  # For the legs that stop a build half-way.
  if [[ -n ${AURCACHE_TEST_LINGER:-} ]]; then
    _probe lingering "$AURCACHE_TEST_LINGER"
    sleep "$AURCACHE_TEST_LINGER"
  fi
}

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/aurcache-agent-hostile/marker"
}
