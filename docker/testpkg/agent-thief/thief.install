# The install scriptlet of `aurcache-agent-thief`, a fixture of
# scripts/test-build-agent.sh. NOT a real package.
#
# It runs as root in the build container when a build installs the package
# as a dependency, from the test's own repository: before the build, when the
# build has no SSH agent yet, though the link's own process is there already.
# It does what a hostile dependency would to take the key away: look for it
# in every file and in every process (the link's among them), and ask every
# socket that answers as an agent for a signature. It starts an agent of its
# own for the hunt to find, so that a hunt that finds nothing is seen to be
# broken. What it finds, and whether it could read the agent's memory, is
# left in /var/tmp/aurcache-thief for the build to report. It also leaves a
# process of root's running, which the agent must end before the build
# starts.
post_install() {
  local out=/var/tmp/aurcache-thief
  mkdir -p "$out"
  echo yes >"$out/ran"
  if (exec 3</proc/1/mem) 2>/dev/null; then echo opened; else echo refused; fi >"$out/mem"
  # The armour line, put together here so that this file does not hold it.
  local armour="-----BEGIN OPENSSH ""PRIVATE KEY-----"
  grep -rlsIF -e "$armour" /etc /root /var /tmp /work /aurcache /home /srv /run /opt /mnt \
    2>/dev/null | grep -v "^$out/" >"$out/keys"

  # What each process was started with, and its environment. A process whose
  # parent is outside the container was exec'd into it: the relay.
  : >"$out/procs"
  : >"$out/relays"
  local entry pid
  for entry in /proc/[0-9]*; do
    pid=${entry#/proc/}
    if grep -aqsF -e "$armour" "$entry/environ" "$entry/cmdline"; then
      echo "$pid" >>"$out/procs"
    fi
    if [[ $pid != 1 && $(awk '$1 == "PPid:" { print $2 }' "$entry/status" 2>/dev/null) == 0 ]]; then
      echo "$pid" >>"$out/relays"
    fi
  done

  # Its own agent, which the hunt must find.
  local own=$out/own.sock own_pid
  ssh-keygen -q -t ed25519 -N '' -C thief -f "$out/own-key" >/dev/null 2>&1
  own_pid=$(ssh-agent -a "$own" -s 2>/dev/null | sed -n 's/^SSH_AGENT_PID=\([0-9]*\);.*/\1/p')
  SSH_AUTH_SOCK=$own ssh-add -q "$out/own-key" >/dev/null 2>&1
  rm -f "$out/own-key" "$out/own-key.pub"

  # Every socket that answers as an agent, asked for an SSHSIG: `own` for
  # its own, `other` for any other.
  : >"$out/agents"
  : >"$out/sshsig"
  local socket whose
  for socket in $(find / \( -path /proc -o -path /sys \) -prune -o -type s -print 2>/dev/null); do
    SSH_AUTH_SOCK=$socket timeout 5 ssh-add -L >"$out/pub" 2>/dev/null || continue
    grep -q '^ssh-' "$out/pub" || continue
    whose=other
    [[ $socket == "$own" ]] && whose=own
    echo "$whose" >>"$out/agents"
    if echo payload | SSH_AUTH_SOCK=$socket timeout 10 \
      ssh-keygen -Y sign -f "$out/pub" -n file >/dev/null 2>&1; then
      echo "$whose:signed" >>"$out/sshsig"
    else
      echo "$whose:refused" >>"$out/sshsig"
    fi
  done
  [[ -n $own_pid ]] && kill "$own_pid" 2>/dev/null
  rm -f "$own"
  chmod -R a+rX "$out"
  setsid sleep 3600 </dev/null >/dev/null 2>&1 &
}
