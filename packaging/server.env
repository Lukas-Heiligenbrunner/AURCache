# AURCache server configuration. Every value here is optional; the defaults
# work for a single machine serving on localhost.
#
# The full list is documented at Configuration -> Environment variables.

# Where workers and pacman clients reach this server. Needed once anything
# talks to it from another machine.
#AURCACHE_URL=https://aur.example.com

# Sign-in. Leave every OAUTH_* value unset to run without authentication,
# which is only sensible on a machine nothing else can reach.
#OAUTH_AUTH_URI=
#OAUTH_TOKEN_URI=
#OAUTH_REDIRECT_URI=
#OAUTH_USERINFO_URI=
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
# Restrict sign-in to these addresses. Unset means anyone your provider
# authenticates, which for a public provider means anyone at all.
#OAUTH_ALLOWED_USERS=you@example.com

# PostgreSQL instead of the bundled SQLite.
#DB_TYPE=POSTGRESQL
#DB_HOST=
#DB_USER=
#DB_PWD=

#LOG_LEVEL=info
