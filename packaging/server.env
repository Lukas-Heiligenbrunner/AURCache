# AURCache server configuration. Every value here is optional; the defaults
# work for a single machine serving on localhost.
#
# The full list is documented at Configuration -> Environment variables.
# https://github.com/Lukas-Heiligenbrunner/AURCache/blob/master/docs/docs/Configuration/environment-variables.md

# Needed once anything reaches this server from another machine.
#
# The host names workers dial it by: its worker certificate must be valid for
# them, or they refuse it.
#AURCACHE_TLS_SANS=aur.example.com,localhost
# Where pacman clients, and the builds on workers, fetch the repository.
#AURCACHE_PUBLIC_URL=http://aur.example.com:8081

# Approving workers. A new worker waits for approval on the Workers page,
# unless one of these lets it in: a secret shared with every worker you set up,
# or the fingerprints of particular workers.
#AURCACHE_ENROLLMENT_TOKEN=
#AURCACHE_PREAPPROVED_WORKERS=

# Sign-in. Leave every OAUTH_* value unset to run without authentication,
# which is only sensible on a machine nothing else can reach.
#OAUTH_AUTH_URI=
#OAUTH_TOKEN_URI=
#OAUTH_REDIRECT_URI=
#OAUTH_USERINFO_URI=
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
# Restrict sign-in to these addresses. Unset means anyone your provider
# authenticates, which for a public provider means anyone at all.
#OAUTH_ALLOWED_USERS=you@example.com

# PostgreSQL instead of the bundled SQLite.
#DB_TYPE=POSTGRESQL
#DB_HOST=
#DB_USER=
#DB_PWD=

#LOG_LEVEL=info
