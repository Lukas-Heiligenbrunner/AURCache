# AURCache worker configuration. Every value here is optional; the defaults
# work for a worker on the same machine as the server.
#
# The full list is documented at Workers -> Worker Configuration:
# https://github.com/Lukas-Heiligenbrunner/AURCache/blob/master/docs/docs/workers/split-chroot.md

# The server this worker builds for: its worker-protocol listener, port 8083
# unless the server sets AURCACHE_WORKER_PORT. The default is a server on this
# machine.
#AURCACHE_URL=https://aur.example.com:8083

# A new worker waits for approval on the server's Workers page. To skip that,
# give it the secret the server has as AURCACHE_ENROLLMENT_TOKEN. Either way,
# once approved it authenticates with its own certificate.
#AURCACHE_ENROLLMENT_TOKEN=

# Pin the server's CA on first contact. Without it the first connection is
# trust-on-first-use.
#AURCACHE_SERVER_CA_FINGERPRINT=

# The name the Workers page shows. Defaults to the hostname. For a name built
# from the hostname, set `Environment=WORKER_NAME=%H-chroot` in a systemd
# drop-in instead.
#WORKER_NAME=

# What this worker builds. Defaults to the host architecture, the only one a
# chroot worker can build for.
#WORKER_ARCHES=x86_64

# Policy settings: each has a plain name that pins the value on this machine,
# and a `_DEFAULT` name that sets a starting point AURCache may change from the
# worker's page. Prefer `_DEFAULT` unless this machine must keep the value.

# How many builds may run at once. Defaults to 1.
#WORKER_CONCURRENCY_DEFAULT=2

# Restrict this worker to particular packages, and rank it against others.
#WORKER_PACKAGES_DEFAULT=
#WORKER_PRIORITY_DEFAULT=0

# The build user. Must match the user the packaging created, and must have
# `aurbuild` as its PRIMARY group -- makechrootpkg carries only the primary gid
# into the chroot.
#WORKER_BUILD_USER=builder
