# AURCache worker configuration.
#
# The two values below are the minimum: without them the worker has nothing to
# enrol with and will not start.

# The server this worker builds for.
AURCACHE_URL=https://aur.example.com

# One-time enrolment token, from the server's Workers page. After the first
# successful enrolment the worker authenticates with its own certificate and
# this is no longer used.
AURCACHE_ENROLLMENT_TOKEN=

# Pin the server's CA on first contact. Without it the first connection is
# trust-on-first-use.
#AURCACHE_SERVER_CA_FINGERPRINT=

# What this worker builds. Defaults to the host architecture; set
# WORKER_EMULATED_ARCHES only if binfmt/qemu is configured for them.
#WORKER_ARCHES=x86_64
#WORKER_EMULATED_ARCHES=

# Policy settings: each has a plain name that pins the value on this machine,
# and a `_DEFAULT` name that sets a starting point AURCache may change from the
# worker's page. Prefer `_DEFAULT` unless this machine must keep the value.

# How many builds may run at once. Defaults to 1.
#WORKER_CONCURRENCY_DEFAULT=2

# Restrict this worker to particular packages, and rank it against others.
#WORKER_PACKAGES_DEFAULT=
#WORKER_PRIORITY_DEFAULT=0

# The build user. Must match the user the packaging created, and must have
# `aurbuild` as its PRIMARY group -- makechrootpkg carries only the primary gid
# into the chroot.
#WORKER_BUILD_USER=builder

# Deriving from a devtools this package has not been tested against? Point this
# at your own copy. It must be the sandbox-wrapping one, not /usr/bin.
#WORKER_MAKECHROOTPKG=/usr/lib/aurcache/bin/makechrootpkg
