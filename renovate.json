{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "prCreation": "immediate",
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,

  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust (Cargo) non-major updates"
    },
    {
      "description": "The frontend's wasm-bindgen and the library that generates its glue only work at the same version, so they move in one PR whatever the update.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wasm-bindgen", "wasm-bindgen-cli-support"],
      "groupName": "wasm-bindgen"
    },
    {
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Dart (pub) non-major updates"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "JavaScript (npm/yarn/pnpm) non-major updates"
    }
  ]
}
